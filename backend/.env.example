PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teotia_blog
DB_USER=root
DB_PASSWORD=

# Optional pool tuning (defaults: 10 connections, queue 20, acquire timeout 5s)
# DB_POOL_CONNECTION_LIMIT=10
# DB_POOL_QUEUE_LIMIT=20
# DB_ACQUIRE_TIMEOUT_MS=5000

JWT_SECRET=change-me-use-long-random-string
JWT_EXPIRE=7d
COOKIE_SECRET=change-me-use-long-random-string

AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

BASE_URL=https://teotiaandco.com
# Local Next.js dev: BASE_URL=http://localhost:3000

# Optional: skip DB ping on startup (not recommended for production)
# SKIP_DB_CHECK=true

# Phase 2 seed (do not commit real passwords)
SEED_ADMIN_EMAIL=admin@teotiaandco.com
SEED_ADMIN_PASSWORD=
